# Required
GOOGLE_API_KEY=

# Domain for SSL (leave empty for IP-only access on http://)
DOMAIN=

# Host port for the gateway API (change if 8000 is already taken on your machine)
GATEWAY_PORT=8010

# Models
LLM_MODEL=gemini-2.5-flash
WHISPER_MODEL=base
WHISPER_COMPUTE_TYPE=int8

# Download
KEEP_MEDIA=1
COOKIES_FILE=/cookies.txt
EXTRACTOR_ARGS=
# Set to 1 to let yt-dlp fetch and execute a remote JS "ejs:github" component
# at runtime (helps solve some extractor challenges). Off by default: it's a
# supply-chain tradeoff, not something to enable silently.
ENABLE_JS_RUNTIMES=0

# How many videos ingest processes at once (e.g. a batch picked from a
# playlist). Whisper transcription is still serialized regardless.
WORKER_CONCURRENCY=2

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json